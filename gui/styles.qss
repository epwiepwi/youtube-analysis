* {
    font-family: "Segoe UI", "Apple SD Gothic Neo", sans-serif;
    color: #e6e6e6;
}

QMainWindow, QWidget#CentralWidget {
    background-color: #0f1115;
}

QWidget#Sidebar {
    background-color: #161920;
    border-right: 1px solid #1f232c;
    min-width: 220px;
    max-width: 220px;
}

QWidget#ContentArea {
    background-color: #0f1115;
}

QLabel#AppTitle {
    font-size: 18px;
    font-weight: 700;
    color: #ffffff;
    padding: 24px 20px 12px;
}

QLabel#AppSubtitle {
    font-size: 11px;
    color: #8b93a3;
    padding: 0 20px 20px;
}

QPushButton#NavButton {
    background: transparent;
    border: none;
    padding: 12px 20px;
    text-align: left;
    font-size: 14px;
    color: #a8b0c2;
    border-left: 3px solid transparent;
}

QPushButton#NavButton:hover {
    background-color: #1c2029;
    color: #ffffff;
}

QPushButton#NavButton[active="true"] {
    background-color: #1c2029;
    color: #ffffff;
    border-left-color: #4ade80;
    font-weight: 600;
}

QLabel.sectionTitle {
    font-size: 22px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 4px;
}

QLabel.sectionSub {
    font-size: 13px;
    color: #8b93a3;
    margin-bottom: 24px;
}

QLabel.fieldLabel {
    font-size: 12px;
    color: #a8b0c2;
    font-weight: 600;
    padding-bottom: 4px;
}

QLineEdit, QTextEdit, QComboBox {
    background-color: #1c2029;
    border: 1px solid #2a2f3c;
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 13px;
    color: #e6e6e6;
    selection-background-color: #4ade80;
    selection-color: #000000;
}

QLineEdit:focus, QTextEdit:focus {
    border-color: #4ade80;
}

QLineEdit:read-only {
    background-color: #161920;
    color: #8b93a3;
}

QPushButton.primary {
    background-color: #4ade80;
    color: #0f1115;
    border: none;
    border-radius: 8px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 700;
}

QPushButton.primary:hover {
    background-color: #22c55e;
}

QPushButton.primary:disabled {
    background-color: #2a2f3c;
    color: #6b7385;
}

QPushButton.secondary {
    background-color: #1c2029;
    color: #e6e6e6;
    border: 1px solid #2a2f3c;
    border-radius: 8px;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton.secondary:hover {
    background-color: #242937;
    border-color: #3a4052;
}

QProgressBar {
    background-color: #1c2029;
    border: none;
    border-radius: 6px;
    height: 10px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #4ade80;
    border-radius: 6px;
}

QTextEdit#LogArea {
    background-color: #0a0c10;
    border: 1px solid #1f232c;
    font-family: "Consolas", "Menlo", monospace;
    font-size: 12px;
    color: #a8b0c2;
}

QCheckBox {
    spacing: 8px;
    color: #e6e6e6;
    font-size: 13px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #2a2f3c;
    border-radius: 4px;
    background: #1c2029;
}

QCheckBox::indicator:checked {
    background: #4ade80;
    border-color: #4ade80;
    image: url(:/check.svg);
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #2a2f3c;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #3a4052;
}
