# 복사해서 .env 로 저장하고 값을 채우세요. (.env 는 깃에 안 올라감)

# ---- LLM (대본 생성) : anthropic 또는 gemini ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- ElevenLabs (TTS) ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# 초반 구린 음성 잘라내기용 '버리는 멘트'
THROWAWAY_INTRO=음... 자, 그럼 시작해볼게요.

# ---- 캡컷 드래프트 폴더 (윈도우) ----
# 비워두면 output 폴더에 생성됨. 캡컷에 바로 뜨게 하려면 아래처럼 지정:
# CAPCUT_DRAFT_DIR=C:\Users\사용자명\AppData\Local\JianyingPro\User Data\Projects\com.lveditor.draft
CAPCUT_DRAFT_DIR=

# ---- 영상 규격 (세로 숏폼 기본) ----
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
